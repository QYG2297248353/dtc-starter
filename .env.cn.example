# ============================================================
# Medusa 后端部署配置 — 中文注解版
# ============================================================
# 用法：
#   1. 复制本文件为 .env：cp .env.cn.example .env
#   2. 按下面说明填写；.env 已被 .gitignore 忽略，绝不要提交真实密钥。
#   3. 修改后执行：docker compose up -d
# ============================================================

# ── 必填：密钥 ─────────────────────────────────────────────
# 生产环境必须使用强随机值，例如：openssl rand -base64 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# ── PostgreSQL 数据库 ─────────────────────────────────────
# 默认使用 docker compose 内置的 db 容器：以下三项会拼出内部 DATABASE_URL。
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa

# 如果使用外部 PostgreSQL，请设置完整连接串（会覆盖上面的三项）。
# 注意：数据库本身必须提前创建，Medusa 只负责迁移表结构。
#
# Medusa 对非 localhost 主机默认启用 SSL：
#   - 云数据库已启用 SSL（RDS / Supabase 等）：直接写连接串，无需额外参数
#   - 自建 PostgreSQL 未启用 SSL：必须追加 ?sslmode=disable（不要写成 ssl_mode）
#
# DATABASE_URL=postgres://用户名:密码@数据库主机:5432/数据库名
# DATABASE_URL=postgres://用户名:密码@数据库主机:5432/数据库名?sslmode=disable

# ── Redis ─────────────────────────────────────────────────
# 默认使用 compose 内置 redis；外部 Redis 时取消注释并修改：
# REDIS_URL=redis://:密码@redis主机:6379/0
# TLS Redis 示例：
# REDIS_URL=rediss://:密码@redis主机:6380/0

# ── CORS：允许访问后端的前端地址 ───────────────────────────
# 多个地址用英文逗号分隔；生产环境必须改成真实域名。
# STORE_CORS  = 商城前端地址
# ADMIN_CORS  = Admin 后台地址
# AUTH_CORS   = 登录认证允许的来源
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# ── 后端公网地址 ──────────────────────────────────────────
# 必须包含协议、主机和端口，末尾不要加斜杠。
# 本地文件模块用它拼接上传文件（商品图片等）的绝对 URL；
# 不配置或配置错误会导致图片地址变成 localhost。
# 示例：
#   BACKEND_URL=https://api.example.com
#   BACKEND_URL=http://203.0.113.10:9000
BACKEND_URL=http://localhost:9000

# ── Session Cookie 安全设置 ───────────────────────────────
# Medusa 生产模式默认 Secure + SameSite=None，纯 HTTP 部署时
# 浏览器会拒绝写入 Cookie，表现为登录接口 200 但一直跳回登录页。
#
# HTTP 测试部署（IP:端口，无 TLS）：
#   COOKIE_SECURE=false
#   COOKIE_SAME_SITE=lax
# HTTPS 正式部署（Nginx/Traefik/Cloudflare 等终止 TLS）：
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================================
# 支付方式说明
# ============================================================
# 本 fork 默认只启用 Medusa 内置的 Manual（pp_system_default），
# 支付宝是可选接入。
#
# 关于 Stripe：本 fork 默认没有注册 Stripe Provider，所以
# STRIPE_API_KEY / STRIPE_WEBHOOK_SECRET 都不需要填写，填了也不会生效。
# 只有你另外安装并注册 @medusajs/medusa/payment-stripe 时，才需要这些。
#
# 关于 PayPal 等其它支付：同理，未注册的 Provider 不需要环境变量。

# ============================================================
# Manual 支付（Medusa 内置，无需配置）
# ============================================================
# Medusa 自带 Manual Provider（pp_system_default），启动时始终注册，
# 没有“启用/禁用”的环境变量。
# 是否允许客户使用它，请到 Admin → Settings → Regions → Payment providers
# 中勾选或取消；新库 seed 默认会把它加入 Region。
# ============================================================
# 支付宝支付（可选）
# ============================================================
# 不填 APP_ID / PRIVATE_KEY / PUBLIC_KEY 时，支付宝完全不启用，
# 只保留 Medusa 自带的 Manual（pp_system_default）支付方式。
#
# 填好三项凭证并重启后，系统会自动注册三个独立支付 Provider：
#   pp_alipay_pc  → 支付宝（电脑网站支付）
#   pp_alipay_h5  → 支付宝（手机网站支付 H5）
#   pp_alipay_qr  → 支付宝（扫码支付 / 当面付预下单）
#
# 然后到 Admin → Settings → Regions → 编辑 Region → Payment providers，
# 按实际开通的产品勾选需要的一个或多个。用户至少要开通一种；
# 没勾选的 Provider 不会出现在商城结账页。
#
# 支付宝开放平台准备：
#   1. 创建应用，按需开通：电脑网站支付、手机网站支付、当面付（扫码）
#   2. 配置 RSA2 密钥；应用私钥只放后端，绝不提交到 Git
#   3. 异步通知地址填：https://你的后端域名/webhooks/alipay
#      （也可用下面的 ALIPAY_NOTIFY_URL 显式指定）
#
# ── 必填：支付宝应用凭证 ─────────────────────────────────
# 支付宝应用 ID（APPID）
ALIPAY_APP_ID=
# 应用私钥。支持两种写法：
#   a) 直接粘贴完整的 PEM（含 BEGIN/END 行）；
#   b) 单行 + 字面量 \n，例如：
#      ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
# Node.js 使用「非 Java」格式私钥（PKCS#8）即可；系统也兼容 PKCS#1。
ALIPAY_PRIVATE_KEY=
# 支付宝公钥（不是应用公钥），用于验证异步通知和接口响应签名。
ALIPAY_PUBLIC_KEY=

# ── 可选：支付宝网关 ─────────────────────────────────────
# 不填默认生产网关：https://openapi.alipay.com/gateway.do
# 沙箱环境填写：
#   ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=

# ── 可选：异步通知地址 ───────────────────────────────────
# 不填默认：${BACKEND_URL}/webhooks/alipay
# 必须是支付宝能从公网访问的 HTTPS 地址，不能是 localhost。
# 例如：ALIPAY_NOTIFY_URL=https://api.example.com/webhooks/alipay
ALIPAY_NOTIFY_URL=

# ── 可选：同步回跳地址 ───────────────────────────────────
# 不填时由商城前端按购物车自动生成回跳地址；
# 只有自建前端且不使用内置 storefront 时才需要设置。
# 例如：ALIPAY_RETURN_URL=https://shop.example.com/order/confirmed
ALIPAY_RETURN_URL=

# ── 可选：商户 PID 校验 ──────────────────────────────────
# 填写后，异步通知里的 seller_id 必须与这里一致，否则拒绝。
# 企业支付宝可在开放平台商家信息中查看 PID。
ALIPAY_SELLER_ID=

# ── 可选：订单标题 ───────────────────────────────────────
# 支付宝订单标题前缀，默认 Order
ALIPAY_SUBJECT_PREFIX=Order

# ── 镜像与端口 ────────────────────────────────────────────
MEDUSA_IMAGE=qyg2297248353/medusa:latest
# 如需使用 GHCR：
# MEDUSA_IMAGE=ghcr.io/qyg2297248353/medusa:latest
# 宿主机映射端口（容器内部始终监听 9000）
PORT=9000
