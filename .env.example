# Example environment for docker-compose.yml — copy to .env and edit.
# .env is gitignored; never commit real secrets.

# ── Required ──────────────────────────────────────────────
# Strong random values in production, e.g.: openssl rand -base64 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# ── PostgreSQL ────────────────────────────────────────────
# Bundled db service (default): these three build the internal DATABASE_URL.
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa
#
# External database instead: set the full URL (overrides the three above).
# The database itself must already exist — Medusa migrates but never creates it.
# Medusa enables SSL by default for non-localhost hosts:
#   PG with SSL (RDS/Supabase/...):    no extra param needed
#   PG without SSL (self-hosted):      append ?sslmode=disable (no underscore)
# DATABASE_URL=postgres://user:pass@your-pg-host:5432/medusa
# DATABASE_URL=postgres://user:pass@your-pg-host:5432/medusa?sslmode=disable

# ── Redis ─────────────────────────────────────────────────
# Default points at the bundled redis service. Override for external Redis:
# REDIS_URL=redis://:password@your-redis-host:6379/0
# TLS variant:
# REDIS_URL=rediss://:password@your-redis-host:6380/0

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins; set real domains in production.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

# ── Backend public URL ────────────────────────────────────
# The public base URL of the backend (no trailing slash).
# The local file module uses it to build absolute URLs for uploaded
# files (product images, etc.). If unset, Medusa defaults to
# http://localhost:9000, so product images break on any real domain.
# Set this to the URL users actually reach the backend at, e.g.:
#   BACKEND_URL=https://api.example.com
#   BACKEND_URL=http://203.0.113.10:9000
BACKEND_URL=http://localhost:9000

# ── Session Cookie ────────────────────────────────────────
# Medusa production mode (NODE_ENV=production) defaults to
# Secure + SameSite=None, which breaks plain-HTTP deployments
# because browsers refuse to write Secure cookies over HTTP.
#
# Choose the values that match your actual access scheme:
#
#   HTTP test deploy (IP:port, no TLS / no reverse-proxy):
#     COOKIE_SECURE=false
#     COOKIE_SAME_SITE=lax
#
#   HTTPS deploy (TLS terminated at reverse proxy / load balancer):
#     COOKIE_SECURE=true
#     COOKIE_SAME_SITE=lax
#
# COOKIE_SECURE=false allows Set-Cookie without the Secure flag,
# which is required for browsers to write session cookies over
# plain HTTP. If you terminate TLS at a reverse proxy (Nginx/
# Traefik/Cloudflare/etc.) before the backend, set COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ── Payments ──────────────────────────────────────────────
# Default payment method: Medusa's built-in Manual (pp_system_default); no env.
# Alipay is optional and configured below.
# Stripe is NOT registered in this fork: STRIPE_API_KEY / STRIPE_WEBHOOK_SECRET
# are not needed and have no effect. Add and register the Stripe provider
# separately only if you actually want Stripe.

# ── Alipay (optional) ─────────────────────────────────────
# Adds THREE Alipay providers next to the built-in Manual provider:
#   pp_alipay_pc, pp_alipay_h5, pp_alipay_qr
# The Manual provider (pp_system_default) is installed by Medusa and always
# registered; enable/disable it or any Alipay mode per Region in the Admin:
# Admin > Settings > Regions > Payment providers. At least one may be enabled.
# Leave APP_ID / PRIVATE_KEY / PUBLIC_KEY empty to disable Alipay entirely.
#
# 1. Create an Alipay application (电脑网站支付 / 手机网站支付 / 当面付 as needed)
#    on https://open.alipay.com
# 2. Set the async notify URL to:
#      https://<your-api-domain>/webhooks/alipay
#    (or set ALIPAY_NOTIFY_URL explicitly)
# 3. Paste the app private key as ONE line with literal \n separators:
#      ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Defaults to the production gateway. Sandbox:
#   ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=
# Defaults to ${BACKEND_URL}/webhooks/alipay
ALIPAY_NOTIFY_URL=
# Optional default return URL. The bundled storefront passes its own per-session.
ALIPAY_RETURN_URL=
# Optional: reject notifications whose seller_id does not match.
ALIPAY_SELLER_ID=
ALIPAY_SUBJECT_PREFIX=Order

# ── Image & port ──────────────────────────────────────────
MEDUSA_IMAGE=qyg2297248353/medusa:latest
# MEDUSA_IMAGE=ghcr.io/qyg2297248353/medusa:latest
PORT=9000
